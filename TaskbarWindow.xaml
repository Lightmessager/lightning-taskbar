<Window x:Class="LightningTaskbar.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightningTaskbar"
        xmlns:glass="clr-namespace:LightningTaskbar.Glass"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Lightning Taskbar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="1200" Height="64" FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="White"/>
        <SolidColorBrush x:Key="FgDim" Color="#B3FFFFFF"/>
        <!-- 任务图标尺寸：图标多时由代码压缩 -->
        <sys:Double x:Key="TaskItemWidth">56</sys:Double>
        <Thickness x:Key="TaskItemMargin">3,0</Thickness>

        <!-- 通用玻璃气泡按钮 -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Bubble" CornerRadius="14" Opacity="0" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                                        <GradientStop Color="#12FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#22FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A0FFFFFF" Offset="0"/>
                                        <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#50FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bubble" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.12" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.12" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bubble" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bubble" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 弹出列表里的一行 -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="10,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 托盘图标：所有鼠标事件都转发给图标所属的应用 -->
        <DataTemplate x:Key="TrayIconTemplate">
            <Border x:Name="Bg" Width="34" Height="40" CornerRadius="10" Background="Transparent" ToolTip="{Binding Title}"
                    MouseEnter="TrayIcon_MouseEnter" MouseLeave="TrayIcon_MouseLeave" MouseMove="TrayIcon_MouseMove"
                    MouseDown="TrayIcon_MouseDown" MouseUp="TrayIcon_MouseUp">
                <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolVisConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
        <!-- ===== 玻璃 ===== -->
        <!-- 实时截取背后画面 → 磨砂 / 倒角折射 / 边缘高光 / 投影 / 透镜雨珠，全部在一个着色器里完成 -->
        <glass:GlassSurface x:Name="GlassBg" CornerRadius="22" Bevel="16" ShadowPad="12"/>
        <!-- 着色器不可用或关闭“真玻璃”时：系统模糊 + 淡色底 + 细边 -->
        <Border x:Name="FallbackBg" Margin="12" CornerRadius="22" Background="#55101420" BorderThickness="1"
                BorderBrush="#30FFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ===== 内容 ===== -->
        <Grid x:Name="ContentGrid" Margin="22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 开始按钮：闪电徽标 -->
            <Button x:Name="StartButton" Style="{StaticResource GlassButton}" Width="52" Height="52" ToolTip="开始" Click="Start_Click">
                <Path Data="M13,2 L4,14 L11,14 L9,22 L20,9 L13,9 Z" Width="24" Height="28" Stretch="Uniform">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFB8D4FF" Offset="0.6"/>
                            <GradientStop Color="#FF7FA8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect x:Name="BoltGlow" Color="#9CC0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                    </Path.Effect>
                </Path>
            </Button>

            <!-- 运行中的窗口 -->
            <ItemsControl x:Name="Tasks" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TaskItem}">
                        <Button x:Name="TaskButton" Style="{StaticResource GlassButton}" Width="{DynamicResource TaskItemWidth}" Height="54" Margin="{DynamicResource TaskItemMargin}"
                                ToolTip="{Binding Title}" Click="Task_Click" MouseUp="Task_MouseUp"
                                MouseEnter="Task_MouseEnter" MouseLeave="Task_MouseLeave">
                            <Button.ContextMenu>
                                <ContextMenu Opened="TaskMenu_Opened">
                                    <!-- 多窗口时这里会换成每个窗口一行（代码里填充） -->
                                    <MenuItem Header="{Binding Title}" IsEnabled="False" Tag="header"/>
                                    <Separator/>
                                    <MenuItem Header="打开新窗口" Click="TaskNew_Click" IsEnabled="{Binding CanPin}"/>
                                    <MenuItem Header="{Binding PinMenuText}" Click="TaskPin_Click" IsEnabled="{Binding CanPin}"/>
                                    <MenuItem Header="关闭窗口" Click="TaskClose_Click"
                                              Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                                    <MenuItem Header="{Binding WindowCount}" HeaderStringFormat="关闭全部 {0} 个窗口" Click="TaskCloseAll_Click"
                                              Visibility="{Binding IsGroup, Converter={StaticResource BoolVis}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid Width="{DynamicResource TaskItemWidth}" Height="54">
                                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                    <Image.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.35"/></Image.Effect>
                                </Image>
                                <Border Width="32" Height="32" CornerRadius="9" Background="#40FFFFFF"
                                        Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                    <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Fg}" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- 同一应用有多个窗口：右上角显示数量 -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0" MinWidth="16" Height="16"
                                        CornerRadius="8" Padding="4,0" Background="#E05B7CFF" BorderBrush="#80FFFFFF" BorderThickness="0.8"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding CountText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- 指示条：活动窗口为长亮条，其它为小圆点 -->
                                <Border x:Name="Indicator" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3"
                                        Height="3.5" Width="6" CornerRadius="2" Background="{DynamicResource FgDim}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Indicator" Property="Width" Value="20"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#FFBFD6FF"/>
                                <Setter TargetName="Indicator" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#9CC0FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- 运行中的应用用悬停预览代替 tooltip -->
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="TaskButton" Property="ToolTipService.IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 运行中应用的悬停预览：实时缩略图（多窗口并排），Q 弹展开 -->
            <Popup x:Name="PeekPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <!-- 外圈透明留白：给回弹时的超出部分和阴影留位置 -->
                <Border x:Name="PeekRoot" Padding="18,18,18,26" Background="Transparent"
                        MouseEnter="Peek_MouseEnter" MouseLeave="Peek_MouseLeave">
                    <Border x:Name="PeekPanel" CornerRadius="20" Padding="8" BorderThickness="1" RenderTransformOrigin="0.5,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#EE1E2532" Offset="0"/>
                                <GradientStop Color="#F2141922" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#70FFFFFF" Offset="0"/>
                                <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#40FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PeekScale"/>
                                <TranslateTransform x:Name="PeekShift"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ItemsControl x:Name="PeekList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PeekItem}">
                                    <Button x:Name="Card" Style="{StaticResource MenuRow}" Click="PeekCard_Click" Width="236" Margin="2">
                                        <StackPanel>
                                            <Grid Height="24" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource MenuRow}" Click="PeekClose_Click"
                                                        Width="24" Height="24" Padding="0" Opacity="0" ToolTip="关闭窗口">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <!-- DWM 缩略图画在这块区域上；最小化的窗口没有画面，就露出底下的大图标 -->
                                            <Border x:Name="Thumb" Height="132" CornerRadius="10" Background="#14FFFFFF">
                                                <Image Source="{Binding Icon}" Width="44" Height="44" Opacity="0.75" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Border>
            </Popup>

            <!-- 右侧：天气 / 音效 / 快速设置 / 时钟 / 显示桌面 -->
            <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 系统托盘：^ 弹出隐藏的图标，常驻图标直接显示 -->
                <Button x:Name="TrayOverflowButton" Style="{StaticResource GlassButton}" Width="30" Height="46" Click="TrayOverflow_Click"
                        ToolTip="显示隐藏的图标">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE70E;" Foreground="{DynamicResource Fg}"/>
                </Button>
                <Popup x:Name="TrayPopup" PlacementTarget="{Binding ElementName=TrayOverflowButton}" Placement="Top"
                       VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                    <Border CornerRadius="16" Padding="8" BorderThickness="1" Background="#E8161C28">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#90FFFFFF" Offset="0"/>
                                <GradientStop Color="#18FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#40FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel>
                            <ItemsControl x:Name="TrayUnpinnedList" ItemTemplate="{StaticResource TrayIconTemplate}" MaxWidth="180">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="中键单击：固定到任务栏 / 取消固定" FontSize="11" Foreground="#99FFFFFF" Margin="4,6,4,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <ItemsControl x:Name="TrayPinnedList" ItemTemplate="{StaticResource TrayIconTemplate}" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 输入法：显示 中/英/EN，点击弹出输入法列表 -->
                <Button x:Name="ImeButton" Style="{StaticResource GlassButton}" Width="40" Height="46" Click="Ime_Click" ToolTip="输入法">
                    <TextBlock x:Name="ImeText" Text="中" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                </Button>
                <Popup x:Name="ImePopup" PlacementTarget="{Binding ElementName=ImeButton}" Placement="Top"
                       VerticalOffset="-12" HorizontalOffset="-110" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                    <Border CornerRadius="16" Padding="8" BorderThickness="1" Background="#EC161C28" MinWidth="260">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#70FFFFFF" Offset="0"/>
                                <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#40FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel>
                            <TextBlock Text="输入法" Foreground="#99FFFFFF" FontSize="12" Margin="10,4,0,6"/>
                            <ItemsControl x:Name="ImeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:InputProfile}">
                                        <Button Style="{StaticResource MenuRow}" Click="ImeItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Check}" Foreground="#FFBFD6FF" FontSize="13" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13.5"/>
                                                    <TextBlock Text="{Binding LanguageName}" Foreground="#80FFFFFF" FontSize="11" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#22FFFFFF" Margin="6,6"/>
                            <Button Style="{StaticResource MenuRow}" Click="ImeSettings_Click">
                                <TextBlock Text="语言与输入法设置…" Foreground="#CCFFFFFF" FontSize="12.5" Margin="22,0,0,0"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="WeatherButton" Style="{StaticResource GlassButton}" Width="46" Height="46" Click="Weather_Click"
                        ToolTip="切换天气：晴 / 雨 / 雷雨">
                    <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Emoji" FontSize="20" Text="⛈"/>
                </Button>
                <Button x:Name="SoundButton" Style="{StaticResource GlassButton}" Width="46" Height="46" Click="Sound_Click"
                        ToolTip="雨声开关（滚轮调音量）" MouseWheel="Sound_Wheel">
                    <TextBlock x:Name="SoundGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Text="&#xE767;" Foreground="{DynamicResource Fg}"/>
                </Button>
                <Button Style="{StaticResource GlassButton}" Width="46" Height="46" Click="QuickSettings_Click" ToolTip="网络 / 音量 / 快速设置">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Text="&#xE713;" Foreground="{DynamicResource Fg}"/>
                </Button>
                <Button Style="{StaticResource GlassButton}" Height="52" Padding="12,0" Click="Clock_Click" ToolTip="通知与日历">
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="12:00" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText" Text="10月29日 周四" FontSize="11.5" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GlassButton}" Width="14" Height="40" Margin="4,0,0,0" Click="ShowDesktop_Click" ToolTip="显示桌面">
                    <Border Width="2" Height="22" CornerRadius="1" Background="{DynamicResource FgDim}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid.ContextMenu>
            <ContextMenu x:Name="BarMenu">
                <MenuItem x:Name="MenuOff" Header="☁  晴（关闭天气）" Click="MenuMode_Click" Tag="Off" IsCheckable="True"/>
                <MenuItem x:Name="MenuRain" Header="🌧  下雨" Click="MenuMode_Click" Tag="Rain" IsCheckable="True"/>
                <MenuItem x:Name="MenuStorm" Header="⛈  雷雨" Click="MenuMode_Click" Tag="Storm" IsCheckable="True"/>
                <Separator/>
                <MenuItem x:Name="MenuSound" Header="雷雨音效" IsCheckable="True" Click="MenuSound_Click"/>
                <MenuItem x:Name="MenuGlass" Header="真玻璃折射（截图 / 录屏时不显示任务栏）" IsCheckable="True" Click="MenuGlass_Click"/>
                <MenuItem x:Name="MenuExplorer" Header="资源管理器玻璃背景" IsCheckable="True" Click="MenuExplorer_Click"/>
                <MenuItem Header="⚡ 来一道闪电" Click="MenuStrike_Click"/>
                <Separator/>
                <MenuItem Header="任务管理器" Click="MenuTaskMgr_Click"/>
                <MenuItem Header="退出 Lightning Taskbar（恢复系统任务栏）" Click="MenuExit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
