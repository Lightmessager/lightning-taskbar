<Window x:Class="LightningTaskbar.StartMenu.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:LightningTaskbar.Glass"
        xmlns:sm="clr-namespace:LightningTaskbar.StartMenu"
        Title="Lightning Start" Width="700" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="White"/>
        <SolidColorBrush x:Key="FgDim" Color="#A6FFFFFF"/>

        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Thin" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate><Border CornerRadius="3" Background="#40FFFFFF"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform><TranslateTransform x:Name="Slide"/></Grid.RenderTransform>

        <glass:GlassSurface x:Name="GlassBg" CornerRadius="26" Bevel="24"/>

        <Grid Margin="28,26,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 搜索框 -->
            <Border CornerRadius="20" Height="44" BorderThickness="1" Background="#26000000">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                        <GradientStop Color="#60FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid Margin="16,0">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" Foreground="{StaticResource FgDim}"
                               FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="搜索应用" Foreground="{StaticResource FgDim}" FontSize="15"
                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="Search" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White"
                             CaretBrush="White" FontSize="15" VerticalAlignment="Center" TextChanged="Search_TextChanged"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="6,18,0,8">
                <TextBlock x:Name="SectionTitle" Text="已固定" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="ViewToggle" Style="{StaticResource Tile}" HorizontalAlignment="Right" Padding="12,6" Click="ViewToggle_Click">
                    <TextBlock x:Name="ViewToggleText" Text="所有应用  ›" Foreground="{StaticResource Fg}" FontSize="12.5"/>
                </Button>
            </Grid>

            <!-- 应用网格 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-6,0,-14,0" Padding="0,0,8,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource Thin}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="Apps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type sm:AppEntry}">
                            <Button Style="{StaticResource Tile}" Width="106" Height="98" Click="App_Click" ToolTip="{Binding Name}"
                                    HorizontalContentAlignment="Center">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="AppMenu_Opened">
                                        <MenuItem Header="打开" Tag="open" Click="AppOpen_Click"/>
                                        <MenuItem Header="以管理员身份运行" Tag="admin" Click="AppAdmin_Click"/>
                                        <Separator/>
                                        <MenuItem Tag="pinStart" Click="AppPinStart_Click"/>
                                        <MenuItem Tag="pinBar" Click="AppPinBar_Click"/>
                                        <Separator/>
                                        <MenuItem Header="打开文件位置" Tag="location" Click="AppLocation_Click"/>
                                        <MenuItem Header="卸载…" Tag="uninstall" Click="AppUninstall_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/></Image.Effect>
                                    </Image>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}" FontSize="12" Margin="6,8,6,0"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="96"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底栏：用户 / 系统开始菜单 / 设置 / 电源 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Border Height="1" VerticalAlignment="Top" Margin="-8,-8,-8,0" Background="#22FFFFFF"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF9CC0FF" Offset="0"/>
                                <GradientStop Color="#FF5B7CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="Avatar" Text="L" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="UserName" Text="User" Foreground="{StaticResource Fg}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Tile}" Padding="12,8" Click="NativeStart_Click" ToolTip="打开 Windows 开始菜单">
                        <TextBlock Text="Windows 开始菜单" Foreground="{StaticResource FgDim}" FontSize="12.5"/>
                    </Button>
                    <Button Style="{StaticResource Tile}" Width="42" Height="42" Click="Settings_Click" ToolTip="设置">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Foreground="{StaticResource Fg}"/>
                    </Button>
                    <Button x:Name="PowerButton" Style="{StaticResource Tile}" Width="42" Height="42" Click="Power_Click" ToolTip="电源">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="16" Foreground="{StaticResource Fg}"/>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem Header="睡眠" Click="Sleep_Click"/>
                                <MenuItem Header="注销" Click="SignOut_Click"/>
                                <MenuItem Header="重启" Click="Restart_Click"/>
                                <MenuItem Header="关机" Click="Shutdown_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
