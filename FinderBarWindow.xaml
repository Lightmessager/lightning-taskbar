<Window x:Class="LightningTaskbar.FinderBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:LightningTaskbar.Glass"
        Title="Lightning Finder Bar" SizeToContent="WidthAndHeight" ShowActivated="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 搬进来的状态图标按主题引用这两个资源 -->
        <SolidColorBrush x:Key="Fg" Color="White"/>
        <SolidColorBrush x:Key="FgDim" Color="#B3FFFFFF"/>
    </Window.Resources>
    <Grid>
        <glass:GlassSurface x:Name="GlassBg" CornerRadius="14" Bevel="8" ShadowPad="12"/>
        <!-- 几乎不可见的一层：保证空白处能接收鼠标；状态图标由任务栏窗口搬到 Host 里 -->
        <Border x:Name="Host" Margin="12" Padding="6,3" Background="#02000000" MinHeight="38"
                MouseRightButtonUp="Host_MouseRightButtonUp"/>
    </Grid>
</Window>
